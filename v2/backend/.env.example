# IEP - Icodeup Enterprise Platform - test server environment example.
# Copy values into /etc/icodeup360-test/.env on the server.
# Do not commit real secrets.

APP_NAME="IEP — Icodeup Enterprise Platform"
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8020
FRONTEND_DIR=/opt/icodeup360-test/app/v2/frontend/static
SECRET_KEY=change-me-use-a-long-random-value
SESSION_COOKIE_NAME=icodeup_session
SESSION_HOURS=12
DATABASE_URL=postgresql+psycopg://icodeup_test_user:change-me@127.0.0.1:5432/icodeup_crm_test
TENANT_MODE=shared_schema
PLATFORM_TENANT_SLUG=icodeup-platform
ENABLE_DEMO_DATA=true
ENABLE_DEMO_SEEDS=true
PLATFORM_ADMIN_EMAIL=superadmin@demo.icodeup.local
PLATFORM_ADMIN_PASSWORD=change-me-only-for-test

# Production reminder:
# APP_ENV=production must use its own database and must set:
# ENABLE_DEMO_DATA=false
# ENABLE_DEMO_SEEDS=false
# PLATFORM_ADMIN_EMAIL=<real-internal-admin>
# PLATFORM_ADMIN_PASSWORD=<temporary-secret-rotated-after-first-login>

# Reserved for deployment policy. The current app ignores these variables unless
# future middleware/storage settings are implemented.
DEBUG=false
ALLOWED_ORIGINS=https://test.icodeup.com,http://127.0.0.1:8020
LOG_LEVEL=INFO
UPLOAD_STORAGE_MODE=local
UPLOAD_STORAGE_PATH=/var/lib/icodeup360-test/uploads
MAX_PAGE_SIZE=20
