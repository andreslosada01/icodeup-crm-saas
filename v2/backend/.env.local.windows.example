# Icodeup 360 - local Windows PostgreSQL example.
# Copy this file to v2/.env for local execution. Do not commit v2/.env.
# Replace all change-me values before running outside an isolated local machine.

APP_NAME="Icodeup 360"
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8020
FRONTEND_DIR=../frontend/static
SECRET_KEY=change-me-local-only-use-a-long-random-value
SESSION_COOKIE_NAME=icodeup_session
SESSION_HOURS=12
DATABASE_URL=postgresql+psycopg://icodeup_local_user:change-me@127.0.0.1:5432/icodeup_crm_local
TENANT_MODE=shared_schema
PLATFORM_TENANT_SLUG=icodeup-platform
ENABLE_DEMO_DATA=true
ENABLE_DEMO_SEEDS=true
ENABLE_PILOT_ICODEUP_SEED=false
PLATFORM_ADMIN_EMAIL=superadmin@demo.icodeup.local
PLATFORM_ADMIN_PASSWORD=change-me-local-demo-only

# Local-only operational defaults.
DEBUG=true
ALLOWED_ORIGINS=http://127.0.0.1:8020,http://localhost:8020
LOG_LEVEL=INFO
UPLOAD_STORAGE_MODE=local
UPLOAD_STORAGE_PATH=C:\icodeup360-local\uploads
MAX_PAGE_SIZE=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
