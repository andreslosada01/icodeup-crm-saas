# Icodeup 360 - internal TEST server environment example.
# Copy to /opt/icodeup360_test/app/v2/.env on the server and replace placeholders.
# Do not commit the real .env file or real secrets.

APP_NAME="Icodeup 360"
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8021
DATABASE_URL=postgresql+psycopg://icodeup360_test_user:CAMBIAR_PASSWORD@127.0.0.1:5432/icodeup360_test
SECRET_KEY=CAMBIAR_SECRET
SESSION_COOKIE_NAME=icodeup_test_session
SESSION_HOURS=12
TENANT_MODE=shared_schema
PLATFORM_TENANT_SLUG=icodeup-platform
ENABLE_DEMO_DATA=false
ENABLE_DEMO_SEEDS=false
ENABLE_PILOT_ICODEUP_SEED=false
UPLOAD_STORAGE_PATH=/var/uploads/icodeup360_test
FRONTEND_DIR=../frontend/static
ALLOWED_ORIGINS=http://10.201.16.53:8081,http://10.201.16.53

# Optional initial platform admin. Use only with temporary credentials and rotate.
PLATFORM_ADMIN_EMAIL=admin-test@icodeup.local
PLATFORM_ADMIN_PASSWORD=CAMBIAR_PASSWORD_TEMPORAL

# Operational policy.
LOG_LEVEL=INFO
DEBUG=false
