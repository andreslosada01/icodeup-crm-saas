#!/usr/bin/env bash
set -euo pipefail

# Example restore into TEST database only. Never run against production.
# Required confirmation:
#   CONFIRM_RESTORE=RESTORE_TEST_DB
# Required backup:
#   BACKUP_FILE=/var/backups/icodeup360-test/file.dump.gz

BACKUP_FILE="${BACKUP_FILE:?Set BACKUP_FILE}"
CONFIRM_RESTORE="${CONFIRM_RESTORE:-}"
PGHOST="${PGHOST:-127.0.0.1}"
PGUSER="${PGUSER:-icodeup_test_user}"
TARGET_DB="${TARGET_DB:-icodeup_crm_test_restore}"

if [ "$CONFIRM_RESTORE" != "RESTORE_TEST_DB" ]; then
  echo "Refusing restore. Set CONFIRM_RESTORE=RESTORE_TEST_DB to continue."
  exit 1
fi

case "$TARGET_DB" in
  *prod*|*production*)
    echo "Refusing restore into database name that looks like production: $TARGET_DB"
    exit 1
    ;;
esac

echo "Restoring $BACKUP_FILE into TEST database $TARGET_DB"
dropdb --if-exists --host "$PGHOST" --username "$PGUSER" "$TARGET_DB"
createdb --host "$PGHOST" --username "$PGUSER" "$TARGET_DB"
gunzip -c "$BACKUP_FILE" | pg_restore --no-owner --no-acl --host "$PGHOST" --username "$PGUSER" --dbname "$TARGET_DB"

echo "Restore to test completed."
