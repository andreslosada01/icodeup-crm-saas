#!/usr/bin/env bash
set -euo pipefail

# Example PostgreSQL backup script. Use environment variables or a secure
# pgpass file. Do not place passwords in this script.

BACKUP_DIR="${BACKUP_DIR:-/var/backups/icodeup360}"
DB_NAME="${DB_NAME:-icodeup360}"
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_USER="${DB_USER:-icodeup360}"
STAMP="$(date +%Y%m%d_%H%M%S)"
OUTPUT="$BACKUP_DIR/${DB_NAME}_${STAMP}.dump"

mkdir -p "$BACKUP_DIR"
pg_dump --format=custom --no-owner --no-acl --host "$DB_HOST" --username "$DB_USER" --file "$OUTPUT" "$DB_NAME"

echo "Backup created: $OUTPUT"
