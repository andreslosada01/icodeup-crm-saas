#!/usr/bin/env bash
set -euo pipefail

# Example PostgreSQL backup script for TEST.
# Use PGHOST, PGDATABASE, PGUSER and optionally PGPASSWORD from the environment
# or a secure .pgpass file. Do not place passwords in this script.

BACKUP_DIR="${BACKUP_DIR:-/var/backups/icodeup360-test}"
PGHOST="${PGHOST:-127.0.0.1}"
PGDATABASE="${PGDATABASE:-icodeup_crm_test}"
PGUSER="${PGUSER:-icodeup_test_user}"
STAMP="$(date +%Y%m%d_%H%M%S)"
OUTPUT="$BACKUP_DIR/${PGDATABASE}_${STAMP}.dump.gz"

umask 077
mkdir -p "$BACKUP_DIR"
pg_dump --format=custom --no-owner --no-acl --host "$PGHOST" --username "$PGUSER" "$PGDATABASE" | gzip -c > "$OUTPUT"

echo "Backup created: $OUTPUT"
