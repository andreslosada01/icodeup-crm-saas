#!/usr/bin/env python3
"""
Create or reset an Icodeup 360 platform admin without printing secrets.

Example:
  cd /opt/icodeup360/app/v2
  export PLATFORM_ADMIN_EMAIL="admin@icodeupadvisors.com"
  export NEW_ADMIN_PASSWORD="$(openssl rand -base64 18)"
  python scripts/create_or_reset_platform_admin.py

Do not commit the real copied script, shell history, or generated password.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
BACKEND_DIR = ROOT / "backend"
DEFAULT_ENV_FILE = ROOT / ".env"


def load_env_file(path: Path) -> None:
    if not path.exists():
        return
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[len("export ") :].strip()
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        os.environ.setdefault(key, value)


def main() -> int:
    parser = argparse.ArgumentParser(description="Create or reset a platform admin user.")
    parser.add_argument("--email", default=os.getenv("PLATFORM_ADMIN_EMAIL"), help="Platform admin email.")
    parser.add_argument("--name", default="Icodeup Platform Admin", help="Visible user name.")
    parser.add_argument("--env-file", default=os.getenv("ENV_FILE", str(DEFAULT_ENV_FILE)), help="Path to .env.")
    args = parser.parse_args()

    load_env_file(Path(args.env_file))
    sys.path.insert(0, str(BACKEND_DIR))

    email = (args.email or os.getenv("PLATFORM_ADMIN_EMAIL") or "").strip().lower()
    new_password = os.getenv("NEW_ADMIN_PASSWORD", "")
    if not email:
        print("Missing admin email. Set PLATFORM_ADMIN_EMAIL or pass --email.")
        return 2
    if not new_password:
        print("Missing NEW_ADMIN_PASSWORD. Generate one securely and export it before running.")
        return 2
    if email == "admin@icodeup.local":
        print("Refusing to overwrite the existing local admin. Use a corporate email instead.")
        return 2

    from sqlalchemy import select

    from app.core.roles import PLATFORM_ADMIN
    from app.core.security import hash_password
    from app.core.config import settings
    from app.db.session import SessionLocal
    from app.models.identity import User
    from app.models.security import Role, UserProfile
    from app.models.tenant import Tenant

    if SessionLocal is None:
        print("DATABASE_URL is not configured or database session is unavailable.")
        return 2

    with SessionLocal() as db:
        platform_slug = settings.platform_tenant_slug or "icodeup-platform"
        tenant = db.scalar(select(Tenant).where(Tenant.slug == platform_slug))
        if tenant is None:
            tenant = Tenant(
                name="Icodeup Platform",
                slug=platform_slug,
                tax_id="PLATFORM",
                document_type="NIT",
                document_number="PLATFORM",
                status="active",
                primary_color="#15956f",
                secondary_color="#2563eb",
                timezone="America/Bogota",
            )
            db.add(tenant)
            db.flush()

        user = db.scalar(select(User).where(User.email == email))
        created = False
        if user is None:
            user = User(
                tenant_id=tenant.id,
                name=args.name,
                email=email,
                role=PLATFORM_ADMIN,
                password_hash=hash_password(new_password),
                status="active",
                title="Administrador plataforma Icodeup",
            )
            db.add(user)
            db.flush()
            created = True
        else:
            user.tenant_id = tenant.id
            user.name = user.name or args.name
            user.role = PLATFORM_ADMIN
            user.password_hash = hash_password(new_password)
            user.status = "active"
            user.title = user.title or "Administrador plataforma Icodeup"

        role = db.scalar(select(Role).where(Role.tenant_id.is_(None), Role.code == PLATFORM_ADMIN))
        profile = db.scalar(select(UserProfile).where(UserProfile.user_id == user.id))
        if profile is None:
            profile = UserProfile(user_id=user.id)
            db.add(profile)
        profile.tenant_id = tenant.id
        profile.role_id = role.id if role is not None else None
        profile.is_platform_admin = True
        profile.is_company_admin = False
        profile.status = "active"

        db.commit()

    action = "created" if created else "reset"
    print(f"Platform admin {action}: {email}")
    print("Password was not printed. Test login through the web app.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
