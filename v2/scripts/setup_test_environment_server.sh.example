#!/usr/bin/env bash
set -euo pipefail

# Icodeup 360 internal TEST environment setup example.
# Review before running. This script does not store real passwords and avoids
# destructive actions. Database password and SECRET_KEY must be edited manually.

APP_USER="${APP_USER:-icodeup}"
APP_GROUP="${APP_GROUP:-icodeup}"
APP_ROOT="${APP_ROOT:-/opt/icodeup360_test/app}"
REPO_URL="${REPO_URL:-https://github.com/andreslosada01/icodeup-crm-saas.git}"
BRANCH="${BRANCH:-feature/deploy-test-server}"
UPLOAD_DIR="${UPLOAD_DIR:-/var/uploads/icodeup360_test}"
LOG_DIR="${LOG_DIR:-/var/log/icodeup360_test}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/icodeup360_test}"

echo "Preparing Icodeup 360 TEST folders."
sudo mkdir -p "$APP_ROOT" "$UPLOAD_DIR" "$LOG_DIR" "$BACKUP_DIR"
sudo chown -R "$APP_USER:$APP_GROUP" /opt/icodeup360_test "$UPLOAD_DIR" "$LOG_DIR" "$BACKUP_DIR"
sudo chmod 750 /opt/icodeup360_test "$UPLOAD_DIR" "$LOG_DIR" "$BACKUP_DIR"

if [ ! -d "$APP_ROOT/.git" ]; then
  if [ "$(find "$APP_ROOT" -mindepth 1 -maxdepth 1 | wc -l)" -ne 0 ]; then
    echo "APP_ROOT is not empty and is not a git repository: $APP_ROOT"
    echo "Review manually before cloning."
    exit 1
  fi
  sudo -u "$APP_USER" git clone "$REPO_URL" "$APP_ROOT"
fi

cd "$APP_ROOT"
sudo -u "$APP_USER" git fetch origin
sudo -u "$APP_USER" git checkout "$BRANCH"
sudo -u "$APP_USER" git pull origin "$BRANCH"

if [ ! -f "$APP_ROOT/v2/.env" ]; then
  sudo -u "$APP_USER" cp "$APP_ROOT/v2/backend/.env.test.server.example" "$APP_ROOT/v2/.env"
  chmod 640 "$APP_ROOT/v2/.env"
  echo "Created $APP_ROOT/v2/.env from example."
  echo "Edit DATABASE_URL, SECRET_KEY and temporary admin password before starting services."
else
  echo "Existing $APP_ROOT/v2/.env preserved."
fi

cd "$APP_ROOT/v2/backend"
if [ ! -d "venv" ]; then
  sudo -u "$APP_USER" python3 -m venv venv
fi
sudo -u "$APP_USER" ./venv/bin/pip install --upgrade pip
sudo -u "$APP_USER" ./venv/bin/pip install -r requirements.txt

echo "Next manual steps:"
echo "1. Create PostgreSQL user/database with secure password:"
echo "   DB: icodeup360_test"
echo "   User: icodeup360_test_user"
echo "2. Edit $APP_ROOT/v2/.env with real TEST secrets."
echo "3. Run: cd $APP_ROOT/v2/backend && sudo -u $APP_USER ./venv/bin/alembic upgrade head"
echo "4. Install systemd and Nginx examples from v2/deploy."
echo "5. Validate: curl http://127.0.0.1:8021/api/health"
