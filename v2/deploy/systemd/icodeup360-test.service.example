[Unit]
Description=Icodeup 360 Test
After=network.target

[Service]
User=icodeup
Group=icodeup
WorkingDirectory=/opt/icodeup360-test/app/v2/backend
EnvironmentFile=/etc/icodeup360-test/.env
ExecStart=/opt/icodeup360-test/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/var/log/icodeup360-test/app.out.log
StandardError=append:/var/log/icodeup360-test/app.err.log

[Install]
WantedBy=multi-user.target
