[Unit]
Description=Icodeup 360 Internal Test
After=network.target postgresql.service

[Service]
Type=simple
User=icodeup
Group=icodeup
WorkingDirectory=/opt/icodeup360_test/app/v2/backend
EnvironmentFile=/opt/icodeup360_test/app/v2/.env
ExecStart=/opt/icodeup360_test/app/v2/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8021 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/var/log/icodeup360_test/app.out.log
StandardError=append:/var/log/icodeup360_test/app.err.log

[Install]
WantedBy=multi-user.target
