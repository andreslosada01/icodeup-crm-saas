# Ambiente
APP_ENV=development
APP_NAME=IcodeUp CRM
APP_HOST=127.0.0.1
APP_PORT=8020

# Seguridad
SECRET_KEY=change-me
SESSION_COOKIE_NAME=icodeup_session
SESSION_HOURS=12
PLATFORM_ADMIN_EMAIL=platform@icodeup.com
PLATFORM_ADMIN_PASSWORD=change-me-local-only

# Base de datos
DATABASE_URL=postgresql+psycopg://icodeup:icodeup@localhost:5432/icodeup_crm

# Tenancy
TENANT_MODE=database_per_tenant
PLATFORM_TENANT_SLUG=icodeup-platform

# Integraciones futuras
WHATSAPP_PROVIDER=disabled
EMAIL_PROVIDER=disabled
TELEPHONY_PROVIDER=disabled

# Demo local
ENABLE_DEMO_SEEDS=false
